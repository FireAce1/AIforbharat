<?xml version="1.0" encoding="utf-8"?>
<!-- Network Security Configuration for KrishiAI App -->
<!-- Implements certificate pinning and enforces HTTPS -->
<network-security-config>
    <!-- Base configuration for all domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust system certificate authorities -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Certificate pinning for api.krishiai.com -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">api.krishiai.com</domain>
        <pin-set expiration="2026-12-31">
            <!-- Primary certificate pin (SHA-256 of SPKI) -->
            <!-- Replace with actual certificate pin -->
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
            <!-- Backup certificate pin for rotation -->
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Certificate pinning for auth.krishiai.com -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">auth.krishiai.com</domain>
        <pin-set expiration="2026-12-31">
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

