# PostgreSQL Configuration for WAL Archiving and PITR
# This file contains the necessary configuration changes for continuous archiving

# -------------------------
# Write-Ahead Log (WAL) Settings
# -------------------------

# Enable WAL archiving for point-in-time recovery
wal_level = replica                    # minimal, replica, or logical
                                       # replica enables WAL archiving and streaming replication

# Archive mode must be enabled for continuous archiving
archive_mode = on                      # enables archiving; off, on, or always

# Archive command to upload WAL files to S3
# This command is executed for each completed WAL segment
archive_command = '/usr/local/bin/archive-wal.sh %p %f'
                                       # %p = path of file to archive
                                       # %f = file name only

# Timeout for archive command (30 seconds)
archive_timeout = 60                   # force a WAL file switch after this many seconds
                                       # 0 disables

# -------------------------
# Replication Settings
# -------------------------

# Maximum number of concurrent connections from standby servers
max_wal_senders = 3                    # max number of walsender processes
                                       # (change requires restart)

# Keep at least this many WAL segments for replication
wal_keep_size = 1GB                    # in megabytes; 0 disables

# -------------------------
# Checkpoint Settings
# -------------------------

# Checkpoint frequency affects recovery time
checkpoint_timeout = 15min             # range 30s-1d
max_wal_size = 2GB                     # maximum size to let the WAL grow between checkpoints
min_wal_size = 80MB                    # minimum size to shrink the WAL to

# Spread checkpoints over time to reduce I/O spikes
checkpoint_completion_target = 0.9     # checkpoint target duration, 0.0 - 1.0

# -------------------------
# Logging Settings for Backup Monitoring
# -------------------------

# Log archive command failures
log_min_messages = warning             # values in order of decreasing detail:
                                       # debug5, debug4, debug3, debug2, debug1,
                                       # info, notice, warning, error, log, fatal, panic

# Log checkpoints for monitoring
log_checkpoints = on                   # log checkpoints

# Log connections for audit trail
log_connections = on                   # log connections
log_disconnections = on                # log disconnections

# -------------------------
# Performance Tuning for Backups
# -------------------------

# Shared buffers (25% of RAM for dedicated DB server)
shared_buffers = 512MB                 # min 128kB

# Effective cache size (50-75% of RAM)
effective_cache_size = 1536MB          # typically 50-75% of RAM

# Work memory for sorting and hash operations
work_mem = 16MB                        # min 64kB

# Maintenance work memory for VACUUM, CREATE INDEX, etc.
maintenance_work_mem = 256MB           # min 1MB

# -------------------------
# Connection Settings
# -------------------------

# Maximum number of concurrent connections
max_connections = 100                  # (change requires restart)

# -------------------------
# Notes
# -------------------------

# After updating this configuration:
# 1. Copy to PostgreSQL data directory: /var/lib/postgresql/data/postgresql.conf
# 2. Create archive-wal.sh script in /usr/local/bin/
# 3. Restart PostgreSQL: pg_ctl restart
# 4. Verify archiving: SELECT * FROM pg_stat_archiver;

# To apply these settings in Kubernetes:
# 1. Create ConfigMap with this file
# 2. Mount as volume in PostgreSQL pod
# 3. Update postgresql.conf in container
# 4. Restart PostgreSQL pod
