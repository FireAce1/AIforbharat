# Example Backup Secret Configuration
# Copy this file to backup-secret.yaml and update with actual credentials
# DO NOT commit backup-secret.yaml to version control

apiVersion: v1
kind: Secret
metadata:
  name: backup-s3-credentials
  namespace: default
  labels:
    app: database-backup
type: Opaque
stringData:
  # AWS credentials for S3 access
  AWS_ACCESS_KEY_ID: "your_aws_access_key_id_here"
  AWS_SECRET_ACCESS_KEY: "your_aws_secret_access_key_here"
  
  # Database credentials
  DB_USER: "postgres"
  DB_PASSWORD: "your_database_password_here"

---
# To create the secret from command line instead:
# kubectl create secret generic backup-s3-credentials \
#   --from-literal=AWS_ACCESS_KEY_ID=your_access_key \
#   --from-literal=AWS_SECRET_ACCESS_KEY=your_secret_key \
#   --from-literal=DB_USER=postgres \
#   --from-literal=DB_PASSWORD=your_password \
#   --namespace=default
