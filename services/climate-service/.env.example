# Server Configuration
PORT=3004
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=krishiai_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# IMD API Configuration
IMD_API_URL=https://api.imd.gov.in/v1
IMD_API_KEY=your_imd_api_key_here
IMD_UPDATE_INTERVAL=6

# ISRO MOSDAC Configuration
ISRO_API_URL=https://mosdac.gov.in/api/v1
ISRO_API_KEY=your_isro_api_key_here

# Weather Update Schedule (cron format)
WEATHER_UPDATE_CRON=0 */6 * * *

# Cache TTL (in seconds)
WEATHER_CACHE_TTL=21600
ADVISORY_CACHE_TTL=3600

# Critical Weather Thresholds
CRITICAL_RAINFALL_MM=100
CRITICAL_TEMP_HIGH_C=45
CRITICAL_TEMP_LOW_C=5
CRITICAL_WIND_SPEED_KMH=60

# SMS Gateway Configuration (for alerts)
SMS_GATEWAY_URL=https://api.twilio.com/2010-04-01
SMS_GATEWAY_ACCOUNT_SID=your_account_sid
SMS_GATEWAY_AUTH_TOKEN=your_auth_token
SMS_FROM_NUMBER=+1234567890

# Logging
LOG_LEVEL=info

# Sentry Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
RELEASE_VERSION=1.0.0
