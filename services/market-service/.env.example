# Cron Schedule (IST)
PRICE_UPDATE_CRON=0 6 * * *

# Cache TTL (seconds)
PRICE_CACHE_TTL=3600
FORECAST_CACHE_TTL=21600

# Logging
LOG_LEVEL=info

# Sentry Error Tracking
