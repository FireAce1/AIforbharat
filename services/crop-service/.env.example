# Server Configuration
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql://krishiai:krishiai123@localhost:5432/krishiai_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# API Configuration
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:19006"]

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256

# ML Model Configuration
MODEL_PATH=./models
CROP_RECOMMENDER_MODEL=crop_recommender.pkl
DISEASE_DETECTOR_MODEL=disease_detector.h5

# Cache TTL (seconds)
CACHE_TTL_RECOMMENDATIONS=86400
CACHE_TTL_PREDICTIONS=3600

# Logging
LOG_LEVEL=INFO

# Sentry Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
