{
  "name": "krishiai-platform",
  "version": "1.0.0",
  "description": "AI-powered rural development platform for Indian farmers",
  "private": true,
  "workspaces": [
    "services/*",
    "mobile/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "setup": "bash setup.sh",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "migrate": "npm run migrate --workspace=services/auth-service",
    "seed": "npm run seed --workspaces --if-present"
  },
  "keywords": [
    "agriculture",
    "ai",
    "rural-development",
    "farmers",
    "india"
  ],
  "author": "KrishiAI Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "prettier": "^3.0.3"
  }
}
